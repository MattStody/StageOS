# Copy to .env.local for local development. Never commit .env.local.

# Powers AI features: contract extraction, AI weekly briefs, workflow import.
# Optional — without it those features fall back to canned demo responses and
# the rest of the app works normally.
ANTHROPIC_API_KEY=

# Locks this deployment to a single edition: "finance" or "production".
# Leave UNSET for the full version plus the login-screen version picker.
# Set it on any deployment where users must not be able to switch editions —
# a Production deployment with this set can never reveal financial data.
NEXT_PUBLIC_STAGEOS_EDITION=
